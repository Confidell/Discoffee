@using Discoffee.Models.Constants;
@using Discoffee.ViewModels
@model List<PedidoClienteViewModel>;

@{
    ViewData["Title"] = "Meus Pedidos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Pedido.css" />
}

@functions {
    (string Texto, string Classe) InfoStatus(StatusPedido status)
    {
        switch (status)
        {
            case StatusPedido.Entregue:
                return ("ENTREGUE", "status-finalizado");
            case StatusPedido.Cancelado:
                return ("CANCELADO", "status-cancelado");
            case StatusPedido.EmEntrega:
                return ("EM ROTA", "status-cancelado");
            case StatusPedido.Finalizado:
                return ("FINALIZADO", "status-cancelado");
            default:
                return ("PREPARANDO", "status-preparando");
        }
    }
}

<section class="sessao-pedidos sessao-padrao">
    <h1 class="titulo-pedidos">MEUS PEDIDOS</h1>

    <div class="lista-pedidos">
        @foreach (var pedido in Model)
        {
            var st = InfoStatus(pedido.Status);

            @*RENDERIZA O CARD E O MODAL DE CADA PRODUTO.*@
            <partial name="_ModalPedido" model="pedido" />

            <div class="card-pedido">
                <div class="card-topo">
                    <div class="pedido-numero">#@pedido.IdPedido</div>

                    <div class="box-pedido-info">
                        <div class="pedido-info">
                            <span class="rotulo">Total</span>
                            <span class="valor">@pedido.Total.ToString("C2")</span>
                        </div>

                        <div class="pedido-info">
                            <span class="rotulo">Status</span>
                            <span class="valor @st.Classe">● @st.Texto</span>
                        </div>
                    </div>
                </div>

                <div class="card-meio">
                    <span>@pedido.Itens.Count Produtos inclusos no pedido</span>
                    <button title="Ver detalhes">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0"/>
                            <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"/>
                        </svg>
                    </button>
                </div>

                <div class="card-rodape">
                    <span class="pedido-pagamento"><!-- ícone do pagamento --></span>
                    <span>@pedido.DataHora.ToString("dd/MM/yy")</span>
                </div>
            </div>
        }
    </div>
</section>
