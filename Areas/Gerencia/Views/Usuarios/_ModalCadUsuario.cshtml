@model Discoffee.ViewModels.CadastrarUsuarioViewModel

<dialog id="modal-cadastro" class="modal-usuario">
    <form method="post" enctype="multipart/form-data"
          asp-area="Gerencia" asp-controller="Usuario" asp-action="Cadastrar" class="modal-form">

        <div class="modal-topo">
            <h2>Cadastrar Funcionário</h2>
            <p>Preencha os dados abaixo para cadastrar o funcionário</p>
        </div>

        <div class="modal-corpo">
            <div class="card-pessoais">
                <h3>Dados Pessoais</h3>

                <div class="card">
                    <label for="nome">
                        Nome completo:
                        <input type="text" class="input-form" asp-for="NomeCompleto" placeholder="Digite seu nome completo..." />
                        <span asp-validation-for="NomeCompleto" class="text-danger"></span>
                    </label>
                    <label for="dataNasc">
                        Data de Nascimento:
                        <input type="text" class="input-form dataNasc" asp-for="DataNascimento" placeholder="Ex: 07/04/2003" maxlength="10" />
                        <span asp-validation-for="DataNascimento" class="text-danger"></span>
                    </label>

                    <label for="cpf">
                        CPF:
                        <input type="text" class="input-form cpf" asp-for="CPF" placeholder="Digite seu CPF..." maxlength="14" />
                        <span asp-validation-for="CPF" class="text-danger"></span>
                    </label>

                    <label for="telefone">
                        Telefone:
                        <input type="text" class="input-form tel" asp-for="Telefone" placeholder="Ex: (11) 99245-4543" maxlength="15" />
                        <span asp-validation-for="Telefone" class="text-danger"></span>
                    </label>
                </div>
            </div>
        </div>

        <div class="card-endereco">
            <h3>Dados de Endereço</h3>

            <div class="card">
                <label for="cep">
                    CEP:
                    <input type="text" class="input-form cep" asp-for="CEP" placeholder="Digite seu CEP..." />
                    <span asp-validation-for="CEP" class="text-danger"></span>
                </label>

                <label for="numero">
                    Número:
                    <input type="text" class="input-form" asp-for="NumeroCasa" placeholder="Nº da casa..." />
                    <span asp-validation-for="NumeroCasa" class="text-danger"></span>
                </label>

                <label for="complemento">
                    Complemento:
                    <input type="text" class="input-form" asp-for="Complemento" placeholder="Ex: Apto, Bloco, etc..." />
                </label>
                   
                <label for="rua">
                    Rua:
                    <input type="text" class="input-form rua" disabled placeholder="Nome da rua..." />
                </label>

                <label for="estado">
                    Estado:
                    <input type="text" class="input-form estado" disabled placeholder="UF..." />
                </label>

                <label for="cidade">
                    Cidade:
                    <input type="text" class="input-form cidade" disabled placeholder="Sua Cidade..." />
                </label>

                <label for="bairro">
                    Bairro:
                    <input type="text" class="input-form bairro" disabled placeholder="Seu Bairro..." />
                </label>
            </div>
        </div>

        <div class="card-acesso">
            <h3>Dados de Acesso</h3>
            <div class="card">
                <label for="email">
                    E-mail:
                    <input type="email" class="input-form" asp-for="Email" placeholder="Digite seu e-mail..." />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </label>

                <label for="senha">
                    Senha:
                    <input id="senha" type="password" class="input-form" asp-for="Senha" placeholder="Crie uma senha..." />
                    <span asp-validation-for="Senha" class="text-danger"></span>
                </label>

                <label>
                    Nível de Acesso
                    <select name="CategoriaId" required>
                        <option value="">Selecione a categoria</option>
                        @foreach (var cat in (List<Discoffee.Models.Categoria>)ViewBag.Categorias)
                        {
                            <option value="@cat.IdCategoria">@cat.NomeCategoria</option>
                        }
                    </select>
                </label>
            </div>
        </div>

            <label class="upload">
                <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M4.406 1.342A5.53 5.53 0 0 1 8 0c2.69 0 4.923 2 5.166 4.579C14.758 4.804 16 6.137 16 7.773 16 9.569 14.502 11 12.687 11H10a.5.5 0 0 1 0-1h2.688C13.979 10 15 8.988 15 7.773c0-1.216-1.02-2.228-2.313-2.228h-.5v-.5C12.188 2.825 10.328 1 8 1a4.53 4.53 0 0 0-2.941 1.1c-.757.652-1.153 1.438-1.153 2.055v.448l-.445.049C2.064 4.805 1 5.952 1 7.318 1 8.785 2.23 10 3.781 10H6a.5.5 0 0 1 0 1H3.781C1.708 11 0 9.366 0 7.318c0-1.763 1.266-3.223 2.942-3.593.143-.863.698-1.723 1.464-2.383" />
                    <path fill-rule="evenodd" d="M7.646 4.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 5.707V14.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708z" />
                </svg>
                <span>Clique ou arraste a imagem</span>
                <img class="upload-preview" alt="Pré-visualização" hidden />
                <input type="file" name="ImagemArquivo" accept=".jpg,.jpeg,.png,.webp" hidden />
            </label>
       

        <div class="modal-botoes">
            <button type="button" class="btn-cancelar" data-fechar>Cancelar</button>
            <button type="submit" class="btn-salvar">Cadastrar Produto</button>
        </div>
    </form>
</dialog>