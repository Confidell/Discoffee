@model List<Discoffee.Models.Usuario>
@{
    ViewData["Title"] = "Usuários";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />

<section class="usuario-header">
    <div class="desc-cadFunc">
        <div class="descricao">
            <h2>Lista de Usuários</h2>
            <h4>Visualize, edite usuários ou cadastre funcionários</h4>
        </div>

        <button type="button" class="btn-cadastrar" data-modal="modal-cadastro">
            <svg xmlns="http://www.w3.org/2000/svg" width="45" height="45" fill="currentColor" class="btn-qtd" viewBox="0 0 16 16">
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
            </svg>
            <h3>Novo Funcionário</h3>
        </button>
    </div>
</section>

<section class="sessao-busca">
    <div class="buscar">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="icone-busca" viewBox="0 0 16 16">
            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
        </svg>
        <input type="search" placeholder="Buscar produto..." />
    </div>

    <div class="nivelAcesso-status">
        <div class="niv-status">
            <div class="nivelAcesso-selecao">
                <h5>Nível de Acesso</h5>
                <h6>Todos</h6>
            </div>
            <img src="/Assets/Icons/Icon_SetaBaixoPreta.png" alt="" class="icone-seta" />
        </div>

        <div class="niv-status">
            <div class="nivelAcesso-selecao">
                <h5>Status</h5>
                <h6>Todos</h6>
            </div>
            <img src="/Assets/Icons/Icon_SetaBaixoPreta.png" alt="" class="icone-seta" />
        </div>
    </div>
</section>

<div class="cards-usuarios">
    <div class="usu-header">
        <h2>Usuário</h2>
        <h2>Nível de Acesso</h2>
        <h2>Status</h2>
        <h2>Vizualizar</h2>
    </div>

    <div class="lista-usuarios">
       @foreach (var usuario in Model)
        {
            <partial name="_CardUsuario" model="usuario" />
        }
    </div>
</div>