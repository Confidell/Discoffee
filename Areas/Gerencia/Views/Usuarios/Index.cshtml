@using System.Security.Claims
@using Discoffee.Models.Constants
@model List<Discoffee.Models.Usuario>
@{
    ViewData["Title"] = "Usuários";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var perfil = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
}

@if (TempData["Erro"] != null)
{
    <div class="mensagem-erro">
        @TempData["Erro"]
    </div>
}

@section Styles{
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbarGerencia.css" />
}

<section class="sessao-padrao sessao-usuarios">

    @await Html.PartialAsync(
        "~/Areas/Gerencia/Views/Dashboard/_NavbarDashboard.cshtml"
    )

    <div class="usuario-header">
        
        <div class="desc-cadFunc">
            <div class="descricao">
                <h2>Lista de Usuários</h2>
                <h4>Visualize, edite usuários ou cadastre funcionários</h4>
            </div>

            @if (perfil == EnumPerfil.Administrador.ToString())
            {
                <button type="button" class="btn-cadastrar" data-modal="modal-cadastro">
                    <svg xmlns="http://www.w3.org/2000/svg" width="45" height="45" fill="currentColor" class="btn-qtd" viewBox="0 0 16 16">
                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                    </svg>
                    <h3>Novo Funcionário</h3>
                </button>
            }
        </div>
    </div>

    <div class="container-usuarios">
        
        <div class="sessao-busca">
            <div class="nivelAcesso-status">
                <div class="niv-status filtro" data-filtro="nivel">
                    <div class="nivelAcesso-selecao">
                        <h5>Nível de Acesso</h5>
                        <h6 class="filtro-escolhido">Todos</h6>
                    </div>
                    <img src="/Assets/Icons/Icon_SetaBaixoPreta.png" alt="" class="icone-seta" />

                    <ul class="filtro-menu" hidden>
                        <li><button type="button" data-valor="">Todos</button></li>
                        <li><button type="button" data-valor="Administrador">Administrador</button></li>
                        <li><button type="button" data-valor="Funcionario">Funcionário</button></li>
                        <li><button type="button" data-valor="Cliente">Cliente</button></li>
                    </ul>
                </div>

                <div class="niv-status filtro" data-filtro="status">
                    <div class="nivelAcesso-selecao">
                        <h5>Status</h5>
                        <h6 class="filtro-escolhido">Todos</h6>
                    </div>
                    <img src="/Assets/Icons/Icon_SetaBaixoPreta.png" alt="" class="icone-seta" />

                    <ul class="filtro-menu" hidden>
                        <li><button type="button" data-valor="">Todos</button></li>
                        <li><button type="button" data-valor="Ativo">Ativo</button></li>
                        <li><button type="button" data-valor="Inativo">Inativo</button></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="cards-usuarios">
            <div class="usu-header">
                <h2>Usuário</h2>
                <h2>Nível de Acesso</h2>
                <h2>Status</h2>
                <h2>Vizualizar</h2>
            </div>

            <div class="lista-usuarios">
                @foreach (var usuario in Model)
                {
                    <partial name="_CardUsuario" model="usuario" />
                }
            </div>
        </div>
    </div>
</section>


@{
    var usuarioCadastro = ViewData["UsuarioCadastro"] as Discoffee.Models.Usuario ?? new Discoffee.Models.Usuario();
}
<partial name="_ModalCadUsuario" model="usuarioCadastro" />


@foreach (var usuario in Model)
{
    <partial name="_ModalVisualizar_EditarUsuario" model="usuario" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/usuarios.js" asp-append-version="true"></script>
    <script src="~/js/filtro.js" asp-append-version="true"></script>
    @if (ViewData["AbrirModal"] is true)
    {
        <script>document.getElementById("modal-cadastro").showModal();</script>
    }
}