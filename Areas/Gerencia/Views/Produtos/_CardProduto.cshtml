@model Discoffee.Models.Produto
@{
    var ptBR = new System.Globalization.CultureInfo("pt-BR");
}

<div class="card-prod">
    <img src="~/Assets/Imagens/@Model.Imagem" alt="@Model.Nome" class="prod-img" />
    <div class="nome-cat">
        <h4>@Model.Nome</h4>
        <h6>@Model.Categoria?.NomeCategoria</h6>
    </div>

    <article><p>@Model.Descricao</p></article>

    <span>@Model.Preco.ToString("C2", ptBR)</span>

    <div class="status">
        <label class="switch">
            <input type="checkbox" class="toggle-status" data-id="@Model.IdProduto" @(Model.Disponibilidade ? "checked" : "") />
            <span class="slider"></span>
        </label>
    </div>
    
    <div class="btn-acoes">

        <button type="button" class="btn-card-prod" data-modal="modal-editar-@Model.IdProduto">
            <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" fill="currentColor" id="btn-editar" viewBox="0 0 16 16">
                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
            </svg>
        </button>
    </div>
</div>