@using System.Security.Claims
@using Discoffee.Models.Constants
@model Discoffee.Models.Cupom
@{
    var ptBR = new System.Globalization.CultureInfo("pt-BR");

    var perfil = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
    var ativo = Model.DataValidade >= DateTime.Now;
    var textoStatus = ativo ? "Ativo" : "Expirado";
    var classeStatus = ativo ? "cupom-ativo" : "cupom-expirado";
}

<div class="card-cupom" data-item data-status="@textoStatus">
    <h4>@Model.IdCupom</h4>
    
    <h4>@Model.Codigo</h4>

    <h4>@Model.Desconto?.ToString("C2", ptBR)</h4>

    <div class="cupom-status @classeStatus">
        <span class="bolinha"></span>
        <p>@textoStatus</p>
    </div>

    <span>@Model.DataValidade?.ToString("dd/MM/yyyy HH:mm")</span>

    <div class="btn-acoes">
    
        @if(perfil == EnumPerfil.Administrador.ToString()){
            
            <button type="button" class="btn-editar" data-modal="modal-editar-@Model.IdCupom">
                <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" fill="currentColor" id="btn-editar" viewBox="0 0 16 16">
                    <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                    <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                </svg>
            </button>
    
            <form asp-area="Gerencia" asp-controller="Cupons" asp-action="Excluir" method="post">
                <input type="hidden" name="idCupom" value="@Model.IdCupom" />
                <button type="submit" class="btn-excluir">
                    <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" fill="currentColor" class="btn-excluir" viewBox="0 0 16 16">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                    </svg>
                </button>
            </form>
            
        }
    </div>
</div>