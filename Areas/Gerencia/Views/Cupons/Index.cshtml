@using System.Security.Claims
@using Discoffee.Models.Constants
@model List<Discoffee.Models.Cupom>
@{
    ViewData["Title"] = "Cupons";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var perfil = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
}

<link rel="stylesheet" href="~/css/cupons.css" asp-append-version="true" />

<section class="sessao-cupons">

    @await Html.PartialAsync(
        "~/Areas/Gerencia/Views/Dashboard/_NavbarDashboard.cshtml"

    )

    <div class="cupons-header">

        <div class="cupons-desc">
            <div class="descricao">
                <h2>Gestão de Cupons</h2>
                <h4>Visualize, edite ou cadastre novos cupons</h4>
            </div>

            @if (perfil == EnumPerfil.Administrador.ToString())
            {
                <button type="button" class="btn-cadastrar" data-modal="modal-cadastro">
                    <svg xmlns="http://www.w3.org/2000/svg" width="45" height="45" fill="currentColor" class="btn-qtd" viewBox="0 0 16 16">
                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                    </svg>
                    <h3>Novo Cupom</h3>
                </button>
            }
        </div>
    </div>

    <div class="container-cupons">
        <div class="sessao-busca">
            <div class="buscar">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="icone-busca" viewBox="0 0 16 16">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                </svg>
                <input type="search" placeholder="Buscar cupom..." />
            </div>

            <div class="filtro-status filtro" data-filtro="status">
                <div class="cat-status">
                    <h5>Status</h5>
                    <h6 class="filtro-escolhido">Todos</h6>
                </div>
                <img src="/Assets/Icons/Icon_SetaBaixoPreta.png" alt="" class="icone-seta" />

                <ul class="filtro-menu" hidden>
                    <li><button type="button" data-valor="">Todos</button></li>
                    <li><button type="button" data-valor="Ativo">Ativo</button></li>
                    <li><button type="button" data-valor="Expirado">Expirado</button></li>
                </ul>
            </div>

        </div>

        <div class="cards-cupons">
            <div class="cup-header">
                <h2>Cupom</h2>
                <h2>Código</h2>
                <h2>Desconto</h2>
                <h2>Status</h2>
                <h2>Validade</h2>
                <h2>Ações</h2>
            </div>

            <div class="lista-cupons">
                @foreach (var cupom in Model)
                {
                    <partial name="_CardCupom" model="cupom" />
                    <partial name="_ModalEditarCupom" model="cupom" />
                }
            </div>
        </div>
    </div>
</section>

<partial name="_ModalCadCupom" />

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script src="~/js/cupom.js" asp-append-version="true"></script>
    <script src="~/js/filtro.js" asp-append-version="true"></script>
}