@using System.Text.Json
@using Discoffee.Models.Constants
@using Discoffee.ViewModels
@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var dataAtual = DateTime.Now;

    @* CONTA O TOTAL FATURADO EM CADA MÊS ATRAVES DOS PAGAMENTOS *@
    var meses = Enumerable.Range(1, 12)
        .Select(m => new
        {
            Mes = new DateTime(dataAtual.Year, m, 1).ToString("MMMM"),
            Total = Model.pagamentos
                .Where(p => p.DataHora.HasValue
                    && p.DataHora.Value.Month == m
                    && p.DataHora.Value.Year == dataAtual.Year
                    && p.Status == EnumStatusPagamento.Pago)
                .Sum(p => p.ValorPago ?? 0)
        })
        .ToList();

    var faturamentoMensal = meses[dataAtual.Month - 1].Total;

    @* PEGA OS 5 PRODUTOS MAIS VENDIDOS *@
    var produtosMaisVendidos = Model.pedidos
        .Where(p => p.Pagamento?.Status == EnumStatusPagamento.Pago)
        .SelectMany(p => p.Itens)
        .GroupBy(i => new { i.IdProduto, i.NomeProduto })
        .Select(g => new
        {
            NomeProduto = g.Key.NomeProduto,
            Quantidade = g.Sum(i => i.Quantidade ?? 0)
        })
        .OrderByDescending(p => p.Quantidade)
        .Take(5)
        .ToList();

    @* PEGA O TOTAL DE PEDIDOS QUE JÁ FORAM PAGOS DE CADA TIPO *@
    var pedidosRetirada = Model.pedidos
    .Count(p => p.Tipo == TipoPedido.Retirada && p.Pagamento?.IdPagamento != null);

    var pedidosEntrega = Model.pedidos
        .Count(p => p.Tipo == TipoPedido.Entrega && p.Pagamento?.IdPagamento != null);

    var pedidosPendentes = Model.pedidos
        .Count(p => p.Status == StatusPedido.Preparando);

    var pedidosHoje = Model.pedidos
        .Count(p => p.DataHora.Date == DateTime.Now.Date);

    var produtosAtivos = Model.produtos
        .Count(p => p.Disponibilidade == true);

    var clientesAtivos = Model.usuarios
        .Count(u => u.Perfil == EnumPerfil.Cliente && u.Status == "Ativo");
}

@section Styles{
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbarGerencia.css" asp-append-version="true" />
}

<section class="sessao-padrao bem-vindo">

    <div class="intro-dashboard">
        <img src="~/Assets/Icons/Logo.svg" id="logo">

        <div class="nome">
            <h3>Olá, seja bem-vindo(a)!</h3>
            <h2>@string.Join(" ", (User.Identity.Name ?? "N/A").Split(' ').Take(2))</h2>
        </div>

        <div class="calendario">
            <button class="seletor-data" id="btnSeletorData" type="button">
                <img src="/Assets/Icons/Icon_Calendario.png" alt="" class="icone-calendario" />
                <span id="textoDataSelecionada">@dataAtual.ToString("dd/MMMM/yyyy")</span>
            </button>

            @* <div class="dropdown-data" id="dropdownData">
                <div class="dropdown-navegacao-ano">
                    <button type="button" id="btnAnoAnterior">&lt;</button>
                    <span id="anoAtual">2026</span>
                    <button type="button" id="btnProximoAno">&gt;</button>
                </div>
                <div class="dropdown-meses" id="dropdownMeses">
                    

                </div>
            </div> *@
        </div>
    </div>

    @* NAVBAR DA GERENCIA *@
    <partial name="_NavbarDashboard" />

</section>

<section class="resumo">
    
    <div class="cards-dados">

        <div class="card-dado">

            <h3>Pedidos em Preparo</h3>
            <hr>
            <p>@pedidosPendentes</p>
        </div>

        <div class="card-dado">
            <h3>Pedidos de Hoje</h3>
            <hr>
            <p>@pedidosHoje</p>
        </div>

        <div class="card-dado">
            <h3>Produtos Ativos</h3>
            <hr>
            <p>@produtosAtivos</p>
        </div>   

        <div class="card-dado">
            <h3>Clientes Ativos</h3>
            <hr>
            <p>@clientesAtivos</p>
        </div>

        <div class="card-dado">
            <h3>Faturamento do Mês</h3>
            <hr>
            <p>R$ @faturamentoMensal</p>
        </div>

    </div>

    <div class="graficos-primarios">

        <div class="faturamento-anual">
            <canvas id="graficoVendas"></canvas>
        </div>

        <div class="produtos-mais-vendidos">
            <canvas id="graficoProdutos"></canvas>
        </div>
    </div>

    <div class="graficos-secundarios">


                <div class="tipos-pedido">
            <canvas id="graficoPedidos"></canvas>
        </div>
    </div>
    
</section>

@section Scripts {

    <script>
        const ctx = document.getElementById('graficoVendas');

        const meses = @Html.Raw(JsonSerializer.Serialize(
            meses.Select(x => x.Mes)
        ));

        const valores = @Html.Raw(JsonSerializer.Serialize(
            meses.Select(x => x.Total)
        ));

        const totalAnual = valores.reduce((total, valor) => total + valor, 0);

        const formatarMoeda = valor => valor.toLocaleString('pt-BR', {
            style: 'currency',
            currency: 'BRL'
        });

        new Chart(ctx, {
            type: 'line',

            data: {
                labels: meses,

                datasets: [{
                    label: 'Total anual: ' + formatarMoeda(totalAnual),
                    data: valores,

                    borderColor: '#0056FF',
                    backgroundColor: 'rgba(0, 86, 255, 0.12)',

                    borderWidth: 3,
                    pointBackgroundColor: '#0056FF',
                    pointBorderColor: '#FFFFFF',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    pointHoverRadius: 7,

                    tension: 0.3,
                    fill: true
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: true,
                    },

                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return formatarMoeda(context.parsed.y);
                            }
                        }
                    }
                },

                scales: {
                    x: {
                        grid: {
                            display: false
                        }
                    },

                    y: {
                        beginAtZero: true,

                        ticks: {
                            callback: function(value) {
                                return formatarMoeda(value);
                            }
                        }
                    }
                }
            }
        });

    const ctxPedidos = document.getElementById('graficoPedidos');

    const pedidosRetirada = @pedidosRetirada;
    const pedidosEntrega = @pedidosEntrega;

    new Chart(ctxPedidos, {
        type: 'doughnut',

        data: {
            labels: ['Retirada', 'Entrega'],

            datasets: [{
                data: [pedidosRetirada, pedidosEntrega],

                backgroundColor: [
                    '#0056FF',
                    '#35E68E'
                ],

                borderWidth: 0,
                hoverOffset: 8
            }]
        },

        options: {
            responsive: true,
            maintainAspectRatio: false,

            plugins: {
                legend: {
                    position: 'bottom'
                },

                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.label + ': ' + context.raw + ' pedidos';
                        }
                    }
                }
            },

            cutout: '65%'
        }
    });

    const ctxProdutos = document.getElementById('graficoProdutos');

    const nomesProdutos = @Html.Raw(JsonSerializer.Serialize(
        produtosMaisVendidos.Select(p => p.NomeProduto)
    ));

    const quantidadesProdutos = @Html.Raw(JsonSerializer.Serialize(
        produtosMaisVendidos.Select(p => p.Quantidade)
    ));

    new Chart(ctxProdutos, {
        type: 'pie',

        data: {
            labels: nomesProdutos,

            datasets: [{
                label: 'Unidades vendidas',
                data: quantidadesProdutos,

                backgroundColor: [
                    '#0056FF',
                    '#35E68E',
                    '#FF7900',
                    '#9747FF',
                    '#C7DFC5'
                ],

                borderWidth: 2,
                borderColor: '#FFFFFF',

                hoverOffset: 8
            }]
        },

        options: {
            responsive: true,
            maintainAspectRatio: false,

            plugins: {
                legend: {
                    display: true,
                    position: 'bottom'
                },

                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.label + ': ' + context.raw + ' unidades';
                        }
                    }
                }
            }
        }
    });
    </script>
}