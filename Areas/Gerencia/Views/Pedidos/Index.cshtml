@using Discoffee.ViewModels
@model List<PedidoAdminViewModel>
@{
    ViewData["Title"] = "Pedidos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/pedidosDashboard.css" asp-append-version="true" />

<section class="pedidos-header">
    <div class="descricao">
        <h2>Gestão de Pedidos</h2>
        <h4>Visualize, inicie, prepare ou confirme pedidos</h4>
    </div>
</section>

<section class="sessao-busca">
    <div class="buscar">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="icone-busca" viewBox="0 0 16 16">
            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
        </svg>
        <input type="search" placeholder="Buscar produto..." />
    </div>

    <div class="status">
        <div class="status-selecao">
            <h5>Status</h5>
            <h6>Todos</h6>
        </div>
        <img src="/Assets/Icons/Icon_SetaBaixoPreta.png" alt="" class="icone-seta" />
    </div>
</section>

<div class="cards-pedidos">
    <div class="ped-header">
        <h2>N° Pedido</h2>
        <h2>Cliente</h2>
        <h2>Status</h2>
        <h2>Total</h2>
        <h2>Vizualizar</h2>
    </div>

    <div class="lista-pedidos">
        @foreach (var pedidoAdminViewModel in Model)
        {
            <partial name="_CardPedido" model="pedidoAdminViewModel" />
            <partial name="_ModalVerPedido" model="pedidoAdminViewModel" />
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pedidosDashboard.js" asp-append-version="true"></script>
}