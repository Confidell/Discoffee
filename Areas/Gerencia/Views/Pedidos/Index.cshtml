@using System.Security.Claims
@using Discoffee.ViewModels
@model List<PedidoAdminViewModel>

@{
    ViewData["Title"] = "Pedidos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var perfil = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
}

@section Styles{
    <link rel="stylesheet" href="~/css/pedidosDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbarGerencia.css" asp-append-version="true" />
}

<section class="sessao-pedidos">

    @await Html.PartialAsync(
    "~/Areas/Gerencia/Views/Dashboard/_NavbarDashboard.cshtml"
)

    <div class="pedidos-header">
        <div class="descricao">
            <h2>Gestão de Pedidos</h2>
            <h4>Visualize, inicie, prepare ou confirme pedidos</h4>
        </div>
    </div>

    <div class="container-pedidos">
        <div class="sessao-busca">
            <div class="filtro-status filtro" data-filtro="status">
                <div class="cat-status">
                    <h5>Status</h5>
                    <h6 class="filtro-escolhido">Todos</h6>
                </div>
                <img src="/Assets/Icons/Icon_SetaBaixoPreta.png" alt="" class="icone-seta" />

                <ul class="filtro-menu" hidden>
                    <li><button type="button" data-valor="">Todos</button></li>
                    <li><button type="button" data-valor="Pendente">Pendente</button></li>
                    <li><button type="button" data-valor="Preparando">Preparando</button></li>
                    <li><button type="button" data-valor="Finalizado">Finalizado</button></li>
                    <li><button type="button" data-valor="EmEntrega">Em entrega</button></li>
                    <li><button type="button" data-valor="Entregue">Entregue</button></li>
                    <li><button type="button" data-valor="Cancelado">Cancelado</button></li>
                </ul>
            </div>
        </div>

        <div class="cards-pedidos">
            <div class="ped-header">
                    <h2>N° Pedido</h2>
                    <h2>Cliente</h2>
                    <h2>Status</h2>
                    <h2>Total</h2>
                    <h2>Visualizar</h2>
            </div>

            <div class="lista-pedidos">
                @foreach (var pedidoAdminViewModel in Model)
                {
                    <partial name="_CardPedido" model="pedidoAdminViewModel" />
                    <partial name="_ModalVerPedido" model="pedidoAdminViewModel" />
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pedidosDashboard.js" asp-append-version="true"></script>
    <script src="~/js/filtro.js" asp-append-version="true"></script>
}