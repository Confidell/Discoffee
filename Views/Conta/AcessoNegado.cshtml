}

<section class="sessao-padrao sessao-acesso-negado">

    <div class="container-mensagem">
        <img class="logo" src="~/Assets/Icons/Logo.svg" alt="Discoffee">

        <div class="texto">
            <h1>ACESSO <span style="color: var(--vermelho);">NEGADO</span>!</h1>

            <p>
                Você não possui permissão para acessar esta página.
            </p>
