@{
    ViewData["Title"] = "Home Page";
}
@section Styles{
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<section class="banner-inicial">
    <div class="overlay"></div>
    
    <article>
        <p class="slogan">SLOGAN AQUI NO MEIO <br> DA TELA INICIAL</p>
    </article>
</section>

<section class="sessao-intro sessao-padrao">

    <img src="~/Assets/Imagens/Imagem_QS.jpg" alt="ilustração-café">

    <article>
        <div class="grupo-titulo">
            <p class="subtitulo">QUALIDADE E SABOR</p>
            <h2 class="titulo-sessao">TÉCNICA E INGREDIENTES SELECIONADOS</h2>
        </div>

        <p class="texto">  Aliamos técnicas refinadas a ingredientes frescos para criar uma experiência inesquecível de sabor. Aqui, nossos doces e salgados são renovados diariamente e as bebidas são preparadas na hora, especialmente para você. Porque, para nós, cuidar de cada detalhe é a melhor forma de cuidar de você.</p>
    
        <a href="" class="botao botao-padrao">
            Experimente
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right icone" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
            </svg>
        </a>
    </article>
</section>

<section class="sessao-produtos sessao-padrao">

    <article>
        <h2 class="titulo-sessao">OEFERECEMOS VARIEDADES</h2>
        <p class="texto">Os mais vendidos e mais procurados pelos <br> amantes do café e suas maravilhas</p>
    </article>

    <div class="grid-cards">

        <div class="card">
            <div class="card-interno">
                    <img src="~/Assets/Imagens/Drinks.jpg" alt="Drinks de Café">
                    <h3><span style="color: var(--amarelo);">DRINK</span><br> DE CAFÉ</h3>

                <div class="card-traseiro">
                    <img src="~/Assets/Icons/Logo.svg" alt="Logo">
                    <h4>DRINK DE CAFÉ</h4>
                    
                    <article>
                        <p><strong style="color: var(--cinza-claro);">Um café para cada momento.</strong> <br> Descubra combinações cremosas, refrescantes e cheias de sabor, preparadas para transformar o seu café em uma experiência diferente.</p>
                        <p><strong>Seu momento merece um café especial.</strong></p>
                    </article>

                    <a href="">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right seta-card" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-interno">
                <img src="~/Assets/Imagens/Tradicionais.jpg" alt="Cafés Tradicionais">
                <h3>CAFÉ <br><span style="color: var(--amarelo);">TRADICIONAL</span></h3>

                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right seta-card" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
                </svg>

                <div class="card-traseiro">
                    <img src="~/Assets/Icons/Logo.svg" alt="Logo">
                    <h4>CAFÉ TRADICIONAL</h4>

                    <article>
                        <p><strong style="color: var(--cinza-claro);">O sabor que nunca sai de moda.</strong> <br> Café preparado com cuidado, aroma marcante e aquele sabor acolhedor que combina perfeitamente com uma pausa no dia.</p>
                        <p><strong>Simples, clássico e irresistível.</strong></p>
                    </article>

                    <a href="">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right seta-card" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-interno">
                <img src="~/Assets/Imagens/Acompanhamentos.jpg" alt="Doces e Salgados">
                <h3>DOCES <span style="color: var(--amarelo);">&</span><br> SALGADOS</h3>

                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right seta-card" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
                </svg>

                <div class="card-traseiro">
                    <img src="~/Assets/Icons/Logo.svg" alt="Logo">
                    <h4>DOCES E SALGADOS</h4>

                    <article>
                        <p><strong style="color: var(--cinza-claro);">Uma pausa fica melhor acompanhada.</strong> <br> Escolha entre doces irresistíveis e salgados deliciosos, preparados para combinar com seu café e deixar cada mordida ainda mais especial.</p>
                        <p><strong>Escolha seu favorito e aproveite.</strong></p>
                    </article>

                    <a href="">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right seta-card" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="sessao-padrao sessao-musica">
    <div class="banner"></div>

    <article>
        <div class="grupo-titulo">
            <p class="subtitulo">PERSONALIDADE E EXPERIÊNCIA</p>
            <h2 class="titulo-sessao">APROVEITE SEU CAFÉ AO SEU SOM FAVORITO</h2>
        </div>

        <div class="textos">
            <div style="line-height: 1;">
                <p class="texto">Confira nossa playlist e adicione suas musicas prediletas<br> para curtir seu café presencialmente.</p>
                <hr>
            </div>

            <div class="cto">
                <a href="">
                    <img src="~/Assets/Icons/Icon_Spotify_Fill.svg" alt="Spotify">
                </a>

                <a href="" class="botao botao-padrao">
                    Venha nos visitar
                </a>
            </div>
        </div>
    </article>
</section>