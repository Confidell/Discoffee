@{
    @*PEGA A ÁREA DA ROTA*@
    var area = ViewContext.RouteData.Values["area"]?.ToString();

    @* PEGA O USUARIO AUTENTICADO DO COOKIE *@
    var autenticado = User.Identity.IsAuthenticated;

    @* PEGA CONTROLLER DA ROTA *@
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();

    @* ESONDE O LAYOUT QUANDO A CONTROLLER FOR "CONTA" *@
    bool ocultarLayout = controller == "Conta";

    @* DEFINE SE A PÁGINA ATUAL É DA ÁREA GERENCIA PARA EXIBIR *@
    bool isGerencia = area == "Gerencia";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Discoffee</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Discoffee.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>

    @if(!ocultarLayout)
    {
        <header>
            <div style="display: flex; align-items: center; gap: 2rem;">
                <h1 class="titulo">
                    DISCOFFEE
                </h1>


                @if(autenticado){
                    <div class="perfil">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-fill icone-perfil" viewBox="0 0 16 16">
                            <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                        </svg>

                        <div class="textos">
                            <span class="boas-vindas">@string.Join(" ", (User.Identity.Name ?? "N/A").Split(' ').Take(2))</span>
                            <a asp-controller="Conta" asp-action="Logout" asp class="logout" style="  color: var(--laranja);font-size: .8rem;">
                                Sair
                            </a>
                        </div>
                    </div>
                }
                else{
                    <div class="login-btns">
                        <button class="entrar">
                            <a asp-controller="Conta" asp-action="Index" asp-route-form="login">ENTRAR</a>
                        </button>
                        <button class="cadastrar">
                            <a asp-controller="Conta" asp-action="Index" asp-route-form="cadastrar">CADASTRAR</a>
                        </button>
                    </div>
                }
            </div>

            <nav>
                <ul>
                    <li><a asp-controller="home" asp-action="index">INÍCIO</a></li>
                    <li><a asp-controller="cardapio" asp-action="index">CARDÁPIO</a></li>
                    <li><a href="">MEUS PEDIDOS</a></li>
                    <li><a href="">PERFIL</a></li>
                    @* @if(autenticado){
                        <li><a href="">MEUS PEDIDOS</a></li>
                        <li><a href="">PERFIL</a></li>
                    } *@
                    <li><a href="">COLEÇÃO</a></li>
                    <li><a href="">CONTATO</a></li>
                    <a href="" style="color: var(--branco);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-bag-fill icon-sacola" style="color: var(--branco);" viewBox="0 0 16 16">
                            <path d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1m3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4z"/>
                        </svg>
                    </a>
                </ul>

                <hr>

                <div class="redes-sociais">
                    <a class="icon" href=""><img src="~/Assets/Icons/Icon_Instagram.svg" alt="Instagram"/></a>
                    <a class="icon" href=""><img src="~/Assets/Icons/Icon_Linkedin.svg" alt="LinkedIn"/></a>
                    <a class="icon" href=""><img src="~/Assets/Icons/Icon_Spotify.svg" alt="Spotify"/></a>
                    <a class="icon" href=""><img src="~/Assets/Icons/Icon_YouTube.svg" alt="YouTube"/></a>
                </div>
            </nav>
        </header>
    }

    @* EXIBE UM POPUP PARA CADA ERRO *@
    @if (!ViewData.ModelState.IsValid)
    {
        foreach (var item in ViewData.ModelState)
        {
            foreach (var erro in item.Value.Errors)
            {
                <div class="popup-erros ">

                    <div class="popup-conteudo">

                        <article class="popup-texto">
                            <h3>ATENÇÃO!</h3>
                            <p>@erro.ErrorMessage</p>
                        </article>

                        <svg onclick="fecharPopup(this)"
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            fill="currentColor"
                            class="bi bi-x botao-fechar"
                            viewBox="0 0 16 16">

                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />

                        </svg>

                    </div>
                </div>
            }
        }
    }

    <div class="main">
        <main role="main" class="">
            @RenderBody()
        </main>
    </div>

    @if(!ocultarLayout)
    {
        <footer>
            <section class="footer-superior">

                <div class="logo-footer">
                    <img src="~/Assets/Icons/Logo.svg" alt="Discoffee" style="width: 45%; height: 45%; object-fit: cover;"/>
                </div>

                <div class="grid-footer">
                    <ul>
                        <h4>CARDÁPIO</h4>
                        <li><a href="">Cafés</a></li>
                        <li><a href="" style="font-weight: 400; margin-left: 15px;">Tradicionais</a></li>
                        <li><a href="" style="font-weight: 400; margin-left: 15px;">Drinks</a></li>
                        <li><a href="">Acompanhamentos</a></li>
                        <li><a href="" style="font-weight: 400; margin-left: 15px;">Doces</a></li>
                        <li><a href="" style="font-weight: 400; margin-left: 15px;">Salgados</a></li>
                        <li><a href="">Bebidas</a></li>
                        <li><a href="" style="font-weight: 400; margin-left: 15px;">Sucos & Refrescos</a></li>
                        <li><a href="" style="font-weight: 400; margin-left: 15px;">Shakes</a></li>
                    </ul>
                    <ul>
                        <h4>COLEÇÃO</h4>
                        <li><a href="">Exclusivos</a></li>
                        <li><a href="">Eventos</a></li>
                        <li><a href="">Parcerias</a></li>
                        <li><a href="">Personalizáveis</a></li>
                    </ul>
                    <ul>
                        <h4>CONHEÇA</h4>
                        <li><a href="">Quem Somos</a></li>
                        <li><a href="">Nossa Equipe</a></li>
                        <li><a href="">Nossos Pilares</a></li>
                        <li><a href="">Estilo</a></li>
                        <li><a href="">Produção</a></li>
                    </ul>
                    <ul>
                        <h4>CONTATO</h4>
                        <li><a href="">Suporte</a></li>
                        <li><a href="">Reembolso</a></li>
                        <li><a href="">Ouvidoria</a></li>
                    </ul>
                </div>
            </section>

            <section class="footer-inferior">
                <div class="footer-redes">
                    <h5>SIGA A DISCOFFEE EM:</h5>
                    <div class="redes-sociais">
                        <a class="icon" href=""><img src="~/Assets/Icons/Icon_Instagram.svg" alt="Instagram"/></a>
                        <a class="icon" href=""><img src="~/Assets/Icons/Icon_Linkedin.svg" alt="LinkedIn"/></a>
                        <a class="icon" href=""><img src="~/Assets/Icons/Icon_Spotify.svg" alt="Spotify"/></a>
                        <a class="icon" href=""><img src="~/Assets/Icons/Icon_YouTube.svg" alt="YouTube"/></a>
                    </div>
                </div>

                <p>©2026 | Todos os direitos reservados.</p>

                <div class="footer-links">
                    <a href="">Termos e Condições</a>
                    <a href="">Privacidade</a>
                </div>
            </section>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/global.js" asp-append-version="true"></script>
    <script src="~/js/cadastrar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
