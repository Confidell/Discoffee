@model List<Discoffee.ViewModels.ItemPedidoViewModel>
@using Discoffee.Models
@using System.Globalization

@{
    ViewData["Title"] = "Carrinho";
    var ptBR = new CultureInfo("pt-BR");

    decimal subtotal = Model.Sum(item =>
    (
        item.PrecoUnitario.GetValueOrDefault() +
        (item.Opcoes?.Sum(opcao => opcao.PrecoExtra) ?? 0)
    ) 
    * item.Quantidade.GetValueOrDefault());

    decimal frete = 0;

    decimal total = subtotal + frete;
}

@section Styles {
    <link rel="stylesheet" href="~/css/carrinho.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Pedido.css" />
}

<div class="box-carrinho">
    <section class="sacola-produtos">
        <div class="minha-sacola">
            <img src="~/Assets/Icons/Icon_SetaBranca.png" />
            <h2>MEU CARRINHO</h2>
        </div>

        <div class="card-externo">

            @if (Model == null || !Model.Any())
            {
                <p class="carrinho-vazio">
                    Seu carrinho está vazio.
                </p>
            }
            else
            {
                @foreach (var item in Model)
                {
                    @await Html.PartialAsync(
                        "~/Areas/Cliente/Views/Pedido/_CardItemPedido.cshtml",
                        item
                    )
                }
            }
        </div>
    </section>

    <section class="resumo-compra">
        <div class="header-resumo">
            <div class="txt-resumo">
                <h2>Resumo da sua compra</h2>
                <h5>Selecione:</h5>
            </div>

            <div class="buttons-radio">
                <div class="btn-tipo">
                    <input type="radio" name="tipo-pedido" value="entrega">
                    <label>Entrega</label>
                </div>

                <div class="btn-tipo">
                    <input type="radio" name="tipo-pedido" value="retirada">
                    <label>Retirada</label>
                </div>
            </div>
        </div>

        <div class="body-resumo">
            <div class="inputs">
                <label for="frete">
                    Frete:
                    <input type="text" id="frete" class="input-form"
                           placeholder="Insira seu CEP" />
                </label>

                <label for="cupom">
                    Cupom:
                    <input type="text" id="cupom" class="input-form"
                           placeholder="Insira o cupom" />
                </label>

                <label for="observacoes">
                    Observações:
                    <input type="text" id="observacoes" class="input-form"
                           placeholder="Insira suas observações" />
                </label>
            </div>

            <hr />

            <div class="total">
                <div class="txt-total">
                    <h4>Subtotal</h4>
                    <span>R$ @subtotal</span>
                </div>

                <div class="txt-total">
                    <h4>Total do frete</h4>
                    <span>R$ @frete</span>
                </div>

                <div class="txt-total">
                    <h4>Pagamento total</h4>
                    <span>R$ @total</span>
                </div>

                <button class="botao botao-realizar-pedido">
                    Realizar Pedido
                </button>
            </div>
        </div>
    </section>
</div>