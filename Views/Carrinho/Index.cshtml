@model List<Discoffee.ViewModels.ItemPedidoViewModel>
@using System.Globalization
@using Discoffee.Models.Constants

@{
    ViewData["Title"] = "Carrinho";
    var ptBR = new CultureInfo("pt-BR");

    decimal subtotal = Model.Sum(item =>
    (
        item.PrecoUnitario.GetValueOrDefault() +
        (item.Opcoes?.Sum(opcao => opcao.PrecoExtra) ?? 0)
    )
    * item.Quantidade.GetValueOrDefault());

    decimal frete = 0;

    decimal total = subtotal + frete;
}

@section Styles {
    <link rel="stylesheet" href="~/css/carrinho.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Pedido.css" />
}

<div class="box-carrinho">
    <section class="sacola-produtos">
        <div class="minha-sacola">
            <a asp-controller="Cardapio" asp-action="Index">
                <img src="~/Assets/Icons/Icon_SetaBranca.png" />
            </a>
            <h2>MEU CARRINHO</h2>
        </div>

        <div class="card-externo">

            @if (Model == null || !Model.Any())
            {
                <p class="carrinho-vazio">
                    Seu carrinho está vazio.
                </p>
            }
            else
            {
                @foreach (var item in Model)
                {
                    @await Html.PartialAsync(
                        "~/Areas/Cliente/Views/Pedido/_CardItemPedido.cshtml",
                        item
                    )
                }
            }
        </div>
    </section>

    <section class="resumo-compra">
        <div class="header-resumo">
            <div class="txt-resumo">
                <h2>Resumo da sua compra</h2>
                <h5>Selecione:</h5>
            </div>

            <div class="buttons-radio">
                <div class="btn-tipo">
                    <input type="radio" id="tipo-entrega" name="Tipo" form="form-finalizar-compra" value="2" checked>
                    <label>@TipoPedido.Entrega</label>
                </div>

                <div class="btn-tipo">
                    <input type="radio" id="tipo-retirada" name="Tipo" form="form-finalizar-compra" value="1">
                    <label>@TipoPedido.Retirada</label>
                </div>
            </div>
        </div>

        <div class="body-resumo">
            <div class="inputs">
                <label for="frete">
                    Frete:
                    <input type="text" id="frete" class="input-form"
                           placeholder="Insira seu CEP" />
                </label>

                <label for="cupom">
                    Cupom:
                    <input type="text" id="cupom" class="input-form"
                           placeholder="Insira o cupom" />
                </label>

            </div>

            <hr />

            <div class="total">
                <div class="txt-total">
                    <h4>Subtotal</h4>
                    <span>R$ @subtotal</span>
                </div>

                <div class="txt-total">
                    <h4>Total do frete</h4>
                    <span>R$ @frete</span>
                </div>

                <div class="txt-total">
                    <h4>Pagamento total</h4>
                    <span>R$ @total</span>
                </div>

                <form id="form-finalizar-compra" asp-area="Cliente" asp-controller="Pedido" asp-action="FinalizarCompra" method="post">
                    <input type="hidden" name="Frete" value="0" />

                    <button type="submit" class="botao botao-realizar-pedido">
                        Realizar Pedido
                    </button>
                </form>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/carrinho.js" asp-append-version="true" ></script>
}