@{
    ViewData["Title"] = "Carrinho";
}

@section Styles {
    <link rel="stylesheet" href="~/css/carrinho.css" asp-append-version="true" />
}

<main>
    <section class="sacola-produtos">
        <div class="minha-sacola">
            <img src="~/Assets/Icons/Icon_SetaBranca.png" />
            <h2>MINHA SACOLA</h2>
        </div>

        <div class="card-externo">
            <div class="produto-carrinho">
                <h4>Produto</h4>
                <h4>Quantidade</h4>
                <h4>Preço</h4>
            </div>
              
            <div class="item-produto">
                <img src="~/Assets/Imagens/Prod1.png" class="prod-img"/>
                <span id="nome-prod">Nome do produto</span>

                <div class="seletor-quantidade">
                    <button onclick="mudar(-1)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="btn-qtd" viewBox="0 0 16 16">
                            <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8" />
                        </svg>
                        
                    </button>
                    <span id="quantidade">1</span>
                    <button onclick="mudar(1)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="btn-qtd" viewBox="0 0 16 16">
                            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                        </svg>
                    </button>
                </div>

                <span id="preco">R$ 8,90</span>
                <div class="btn-acoes">
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" id="btn-editar" viewBox="0 0 16 16">
                        <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                        <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                    </svg>

                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" id="btn-lixo" viewBox="0 0 16 16">
                        <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5" />
                    </svg>

                </div>
                

            </div>
        </div>

    </section>

    <section class="resumo-compra">
        <div class="header-resumo">

            <div class="txt-resumo">
                <h2>Resumo da sua compra</h2>
                <h5>Selecione:</h5>
            </div>

            <div class="buttons-radio">
                <div class="btn-tipo">
                    <input type="radio" name="tipo-pedido" value="entrega">
                    <label>Entrega</label>
                </div>
                
                <div class="btn-tipo">
                    <input type="radio" name="tipo-pedido" value="retirada">
                    <label>Retirada</label>
                </div>
            </div>  
        </div>

        <div class="body-resumo">
            <div class="inputs">
                <label for="frete">
                    Frete:
                    <input type="text" class="input-form" placeholder="Insira seu CEP" />
                </label>

                <label for="cupom">
                    Cupom:
                    <input type="text" class="input-form" placeholder="Insira o cupom" />
                </label>

                <label for="observacoes">
                    Observações:
                    <input type="text" class="input-form" placeholder="Insira suas observações" />
                </label>
            </div>

            <hr/>

            <div class="total">
                <div class="txt-total">
                    <h4>Total produtos</h4>
                    <span>R$ 56,30</span>
                </div>

                <div class="txt-total">
                    <h4>Total do frete</h4>
                    <span>R$ 15,90</span>
                </div>

                <div class="txt-total">
                    <h4>Pagamento total</h4>
                    <span>R$ 72,20</span>
                </div>
                
                <button id="realizar-pedido">
                    Realizar Pedido
                </button>

            </div>
        </div>
    </section>
</main>