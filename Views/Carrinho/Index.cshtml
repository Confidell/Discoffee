@{
    ViewData["Title"] = "Carrinho";
}

@section Styles {
    <link rel="stylesheet" href="~/css/carrinho.css" asp-append-version="true" />
}

<main>
    <section class="sacola-produtos">
        <div class="minha-sacola">
            <img src="~/Assets/Icons/Icon_SetaBranca.png" />
            <h2>MINHA SACOLA</h2>
        </div>

        <div class="card-externo">
            <div class="produto-carrinho">
                <h4>Produto</h4>
                <h4>Quantidade</h4>
                <h4>Preço</h4>
            </div>
              
            <div class="item-produto">
                <img src="~/Assets/Imagens/Prod1.png" class="prod-img"/>
                <span id="nome-prod">Nome do produto</span>

                <div class="seletor-quantidade">
                    <button onclick="mudar(-1)"><img src="~/Assets/Icons/Icon_Mais.png" /></button>
                    <span id="quantidade">1</span>
                    <button onclick="mudar(1)"><img src="~/Assets/Icons/Icon_Menos.png" /></button>
                </div>

                <span id="preco">R$ 8,90</span>
                <button class="btn-lixo"><img src="~/Assets/Icons/Icon_lixo.png" /></button>
            </div>
        </div>

    </section>

    <section class="resumo-compra">
        <div class="header-resumo">

            <div class="txt-resumo">
                <h2>Resumo da sua compra</h2>
                <h5>Selecione:</h5>
            </div>

            <div class="buttons-radio">
                <div class="btn-tipo">
                    <input type="radio" name="tipo-pedido" value="entrega">
                    <label>Entrega</label>
                </div>
                
                <div class="btn-tipo">
                    <input type="radio" name="tipo-pedido" value="retirada">
                    <label>Retirada</label>
                </div>
            </div>  
        </div>

        <div class="body-resumo">
            <div class="inputs">
                <label for="frete">
                    Frete:
                    <input type="text" class="input-form" placeholder="Insira seu CEP" />
                </label>

                <label for="cupom">
                    Cupom:
                    <input type="text" class="input-form" placeholder="Insira o cupom" />
                </label>

                <label for="observacoes">
                    Observações:
                    <input type="text" class="input-form" placeholder="Insira suas observações" />
                </label>
            </div>

            <hr/>

            <div class="total">
                <div class="txt-total">
                    <h4>Total produtos</h4>
                    <span>R$ 56,30</span>
                </div>

                <div class="txt-total">
                    <h4>Total do frete</h4>
                    <span>R$ 15,90</span>
                </div>

                <div class="txt-total">
                    <h4>Pagamento total</h4>
                    <span>R$ 72,20</span>
                </div>
                
                <button id="realizar-pedido">
                    Realizar Pedido
                </button>

            </div>
        </div>
    </section>
</main>