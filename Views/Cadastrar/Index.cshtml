@{
    ViewData["Title"] = "Entrar / Cadastrar";
}

<link rel="stylesheet" href="~/css/cadastrar.css" />
<script src="~/js/global.js" defer></script>

<section class="sessao-conta" style="position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; font-family: sans-serif; box-sizing: border-box;">

    <a id="btn-voltar" asp-controller="Home" asp-action="Index" style="position: absolute; top: 40px; left: 50px; text-decoration: none; color: #333; display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 1rem; z-index: 10;">
        <span style="font-size: 1.2rem;">&larr;</span> Voltar
    </a>

    <!-- Form de Login -->
    <div id="box-login" style="display: block; background: #ffffff; width: 100%; max-width: 440px; padding: 40px 30px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.15); text-align: center; box-sizing: border-box; z-index: 2;">
        <form asp-controller="Login" asp-action="Index" method="post" style="display: flex; flex-direction: column; align-items: center;">
            <h2 style="font-size: 1.3rem; color: #333; margin: 0; font-weight: 700; line-height: 1.3;">
                Entre ou Crie sua <br />
                <span style="color: #FF7900;">CONTA DISCOFFE</span>
            </h2>

            <p style="margin-top: 20px; margin-bottom: 15px; font-size: 0.9rem; color: #444; font-weight: 500;">
                Já possui conta?
            </p>

            <div style="display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 260px;">
                <input type="email" id="email-login" name="email" placeholder="Seu email" style="width: 100%; padding: 8px 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.8rem; box-sizing: border-box;" required />
                <input type="password" id="senha-login" name="senha" placeholder="Sua senha" style="width: 100%; padding: 8px 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.8rem; box-sizing: border-box;" required />
                <a href="javascript:void(0)" style="color: #FF7900; font-size: 0.7rem; text-decoration: none; text-align: left;">
                    Esqueci minha senha
                </a>
            </div>

            <button type="submit" style="margin-top: 20px; background-color: #0015B8; color: #ffffff; border: none; padding: 8px 0; width: 160px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; cursor: pointer;">
                ENTRAR
            </button>

            <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 25px;">
                <a href="javascript:void(0)" id="link-ir-cadastro" style="color: #FF7900; font-weight: 600; font-size: 0.8rem; text-decoration: underline;">
                    Ainda não possui conta?
                </a>
                <a href="javascript:void(0)" style="color: #FF7900; font-size: 0.75rem; text-decoration: underline;">
                    Sou Funcionario
                </a>
            </div>
        </form>
    </div>

    <!-- Form de Cadastro -->
    <div id="box-cadastro" style="display: none; background: #ffffff; width: 900px; height: 530px; border-radius: 8px; padding: 25px 35px; box-shadow: 0 4px 20px rgba(0,0,0,0.15); box-sizing: border-box; z-index: 2;">
        <form asp-controller="Cadastrar" asp-action="Cadastrar" method="post" style="display: flex; flex-direction: column; height: 100%; justify-content: space-between;">
            
            <div style="text-align: center;">
                <h3 style="margin: 0; font-size: 1.1rem; color: #333; font-weight: 700;">Informe seus dados para cadastrar-se.</h3>
                <div style="width: 100%; height: 3px; background-color: #0015B8; margin-top: 10px;"></div>
            </div>

            <div style="display: flex; gap: 30px; margin-top: 10px;">
                
                <!-- Dados Pessoais e Acesso -->
                <div style="flex: 1; display: flex; flex-direction: column; gap: 10px;">
                    
                    <div>
                        <h4 style="margin: 0 0 6px 0; font-size: 0.85rem; color: #333; text-align: center;">Informações de <span style="color: #FF7900;">Acesso</span></h4>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <div>
                                <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Email:</label>
                                <input type="email" name="email" placeholder="Digite seu email.." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                            </div>
                            <div>
                                <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Confirmar Email:</label>
                                <input type="email" name="conf-email" placeholder="Repita o email.." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                            </div>
                            <div>
                                <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Senha:</label>
                                <input type="password" name="senha" placeholder="Crie uma senha.." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                            </div>
                            <div>
                                <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Confirmar Senha:</label>
                                <input type="password" name="conf-senha" placeholder="Repita a senha.." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                            </div>
                        </div>
                    </div>

                    <div style="margin-top: 5px;">
                        <h4 style="margin: 0 0 6px 0; font-size: 0.85rem; color: #333; text-align: center;">Informações <span style="color: #FF7900;">Pessoais</span></h4>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <div>
                                <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Nome:</label>
                                <input type="text" name="nome" placeholder="Digite seu nome.." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                            </div>
                            <div>
                                <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Sobrenome:</label>
                                <input type="text" name="sobrenome" placeholder="Digite seu sobrenome.." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                            </div>
                            <div>
                                <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">CPF:</label>
                                <input type="text" name="cpf" placeholder="Digite seu CPF.." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                            </div>
                            <div>
                                <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Telefone:</label>
                                <input type="text" name="telefone" placeholder="Ex: (11) 99245 - 4543" style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                            </div>
                            <div>
                                <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Data de Nascimento:</label>
                                <input type="text" name="data-nasc" placeholder="Ex: 07/04/2003" style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                            </div>
                            <div>
                                <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Restrições Alimentares:</label>
                                <input type="text" name="restricoes" placeholder="Ex: lactose, glúten, etc." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Dados de Endereço -->
                <div style="flex: 1; border: 2px solid #FF7900; border-radius: 8px; padding: 12px; box-sizing: border-box;">
                    <h4 style="margin: 0 0 8px 0; font-size: 0.85rem; color: #333; text-align: center;">Informações de <span style="color: #FF7900;">Endereço</span></h4>
                    
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <div>
                            <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">CEP:</label>
                            <input type="text" name="cep" placeholder="Digite seu CEP.." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <div>
                                <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Número:</label>
                                <input type="text" name="numero" placeholder="Nº da casa.." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                            </div>
                            <div>
                                <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Complemento:</label>
                                <input type="text" name="complemento" placeholder="Comp., bloco.." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                            </div>
                        </div>

                        <div>
                            <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Rua:</label>
                            <input type="text" name="rua" placeholder="Nome da rua.." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                        </div>

                        <div>
                            <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Estado:</label>
                            <input type="text" name="estado" placeholder="UF.." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                        </div>

                        <div>
                            <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Cidade:</label>
                            <input type="text" name="cidade" placeholder="Sua cidade.." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                        </div>

                        <div>
                            <label style="font-size: 0.7rem; color: #333; font-weight: 600; display: block;">Bairro:</label>
                            <input type="text" name="bairro" placeholder="Seu bairro.." style="width: 100%; padding: 5px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.75rem; box-sizing: border-box;" />
                        </div>
                    </div>
                </div>

            </div>

            <!-- Rodapé e Ações -->
            <div style="display: flex; flex-direction: column; align-items: center; gap: 8px; margin-top: 10px;">
                <label style="font-size: 0.65rem; color: #666; display: flex; align-items: center; gap: 4px;">
                    <input type="checkbox" name="termos" value="sim" style="margin: 0;" /> Concordo com os termos.
                </label>

                <div style="display: flex; gap: 15px;">
                    <button type="submit" style="background-color: #0015B8; color: white; border: none; padding: 6px 40px; border-radius: 20px; font-weight: 700; font-size: 0.8rem; cursor: pointer;">
                        Criar
                    </button>
                    <button type="reset" style="background-color: #ffffff; color: #0015B8; border: 1.5px solid #0015B8; padding: 6px 40px; border-radius: 20px; font-weight: 700; font-size: 0.8rem; cursor: pointer;">
                        Limpar
                    </button>
                </div>
            </div>

        </form>
    </div>

    <img src="~/Assets/Icons/Logo.svg" alt="Logo" style="position: absolute; bottom: 20px; right: 20px; width: 45px; height: auto; z-index: 10;" />
</section>