@{
    ViewData["Title"] = "Cadastrar";
}

<link rel="stylesheet" href="~/css/cadastrar.css" />

<section class="sessao-conta">
    <a id="btn-voltar" asp-controller="Home" asp-action="Index" style="text-decoration: none; display: inline-flex; align-items: center;">
        <img src="~/Assets/Imagens/seta.png" alt="seta" />
        Voltar
    </a>


    <form asp-controller="Cadastrar" asp-action="Cadastrar" method="post" class="form">
        <h2 class="titulo-principal">Informe seus dados para cadastrar-se.</h2>
        <hr class="linha-divisoria"/>

            <div class="inputs">

                <div class="inputs-usuario">

                    <div class="card-acesso card-usuario">
                        <h4>
                            Informações de <span style="color: #FF7900;">Acesso</span>
                        </h4>
                        <div class="card">
                            <label for="email">
                                E-mail:
                                <input type="email" class="input-form" name="email" placeholder="Digite seu e-mail..." />
                            </label>

                            <label for="conf-email">
                                Confirmar E-mail:
                                <input type="email" class="input-form" name="conf-email" placeholder="Repita o e-mail..." />
                            </label>

                            <label for="senha">
                                Senha:
                                <input type="password" class="input-form" name="senha" placeholder="Crie uma senha..." />
                            </label>

                            <label for="senha">
                                Confirmar Senha:
                                <input type="password" class="input-form" name="conf-senha" placeholder="Repita a senha..." />
                            </label>
                        </div>
                    </div>
                
                    <div class="card-pessoais card-usuario">
                        <h4>
                            Informações <span style="color: #FF7900;">Pessoais</span>
                        </h4>

                        <div class="card">
                            <label for="nome">
                                Nome:
                                <input type="text" class="input-form" name="nome" placeholder="Digite seu nome..." />
                            </label>
            
                            <label for="sobrenome">
                                Sobrenome:
                                <input type="text" class="input-form" name="sobrenome" placeholder="Digite seu sobrenome..." />
                            </label>
                            
                            <label for="cpf">
                                CPF:
                                <input type="text" class="input-form" name="cpf" placeholder="Digite seu cpf..." />
                            </label>
            
                            <label for="telefone">
                                Telefone:
                                <input type="text" class="input-form" name="telefone" placeholder="Ex: (11) 99245-4543" />
                            </label>

                            
                            <label for="data-nasc">
                                Data de Nascimento:
                                <input type="text" class="input-form" name="data-nasc" placeholder= "Ex: 07/04/2003" />
                            </label>
            
                            <label for="restricoes">
                                Restrições Alimentares:
                                <input type="text" class="input-form" name="restricoes" placeholder="Ex: lactose, glúten, etc." />
                            </label>
                        </div>
                    </div>

                </div>

                @* INPUTS ENDEREÇO *@
                <div class="card-endereco">
                    <h4 id="txt-end">
                        Informações de <span style="color: #FF7900;">Endereço</span>
                    </h4>
                    <div class="conteudo-card">
                        <label for="cep">CEP:</label>
                        <input type="text" class="input-form" name="cep" placeholder="Digite seu CEP..." />
                        
                        <div id="endereco-grid">
                            <div class="end-grid-1">
                                <label for="numero">
                                    Número:
                                    <input type="text" class="input-form" name="numero" placeholder="Nº da casa..." />
                                </label>
                            </div>

                            <div class="end-grid-2">
                                <label for="complemento">
                                    Complemento:
                                    <input type="text" class="input-form" name="complemento" placeholder="Ex: Apto, Bloco, etc..." />
                                </label>
                            </div>
                        </div>
                        
                        <label for="rua">Rua:</label>
                        <input type="text" class="input-form" name="rua" placeholder="Nome da rua..." />
        
                        <label for="estado">Estado:</label>
                        <input type="text" class="input-form" name="estado" placeholder="UF..." />
        
                        <label for="cidade">Cidade:</label>
                        <input type="text" class="input-form" name="cidade" placeholder="Sua Cidade..." />
                    
                        <label for="bairro">Bairro:</label>
                        <input type="text" class="input-form" name="bairro" placeholder="Seu Bairro..." />
                    </div>
                </div>
            </div>

            <label class="textos">
                <span style="display: flex; align-items: center; justify-content: center;">
                    <input type="checkbox" name="termos" value="sim">
                    Concordo com os termos
                </span>
                <a href="">Já tenho conta.</a>
            </label>
        
            <div class="btn">
                <button type="submit" id="criar" class="botao">
                    Criar
                </button>
                <button type="reset" id="limpar" class="botao">
                    Limpar
                </button>
            </div>

    </form>
    <img src="~/Assets/Icons/Logo.svg" alt="Logo" id="logo" />
</section>