@{
    ViewData["Title"] = "Entrar / Cadastrar";

    string formulario = Context.Request.Query["form"];
}
@section Styles{
    <link rel="stylesheet" href="~/css/cadastrar.css" asp-append-version="true" />
}

<section class="sessao-conta">

    <a id="btn-voltar" asp-controller="Home" asp-action="Index" style="text-decoration: none; display: inline-flex; align-items: center;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right seta" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/>
        </svg>
        Voltar
    </a>

    <!-- Form de Login -->
    <form 
        id="form-login" 
        asp-controller="Cadastrar" 
        asp-action="Index" 
        method="post"
        class="form-login form-conta @(formulario == "cadastrar" ? "form-oculto" : "")"
    >

        <h2 class="titulo-login">
            Entre ou Crie sua <br />
            <span class="titulo-conta">CONTA DISCOFFE</span>
        </h2>

        <p class="texto-conta-existente">
            Já possui conta?
        </p>

        <div class="campos-login">

            <input 
                type="email" 
                id="email-login" 
                name="email" 
                class="campo-login"
                placeholder="Seu email" 
                required 
            />

            <input 
                type="password" 
                id="senha-login" 
                name="senha" 
                class="campo-login"
                placeholder="Sua senha" 
                required 
            />

            <a href="javascript:void(0)" class="link-esqueci-senha">
                Esqueci minha senha
            </a>

        </div>

        <button type="submit" class="botao" id="botao-entrar">
            ENTRAR
        </button>

        <div class="links-login">

            <a
                asp-controller="Cadastrar" 
                asp-action="Index" 
                asp-route-form="cadastrar"
                class="link-form" 
            >
                Ainda não possui conta?
            </a>

        </div>

    </form>

    <!-- Form de Cadastro -->
    <form 
        id="form-cadastro" 
        asp-controller="Cadastrar" 
        asp-action="Cadastrar" 
        method="post" 
        class="form form-conta @(formulario == "login" ? "form-oculto" : "")"
    >
        <h2 class="titulo-principal">Informe seus dados para cadastrar-se.</h2>
        <hr class="linha-divisoria"/>

            <div class="inputs">

                <div class="inputs-usuario">

                    <div class="card-acesso card-usuario">
                        <h4>
                            Informações de <span style="color: var(--rosa);">Acesso</span>
                        </h4>
                        <div class="card">
                            <label for="email">
                                E-mail:
                                <input type="email" class="input-form" name="email" placeholder="Digite seu e-mail..." />
                            </label>

                            <label for="conf-email">
                                Confirmar E-mail:
                                <input type="email" class="input-form" name="conf-email" placeholder="Repita o e-mail..." />
                            </label>

                            <label for="senha">
                                Senha:
                                <input type="password" class="input-form" name="senha" placeholder="Crie uma senha..." />
                            </label>

                            <label for="senha">
                                Confirmar Senha:
                                <input type="password" class="input-form" name="conf-senha" placeholder="Repita a senha..." />
                            </label>
                        </div>
                    </div>
                
                    <div class="card-pessoais card-usuario">
                        <h4>
                            Informações <span style="color: var(--rosa);">Pessoais</span>
                        </h4>

                        <div class="card">
                            <label for="nome">
                                Nome:
                                <input type="text" class="input-form" name="nome" placeholder="Digite seu nome..." />
                            </label>
            
                            <label for="sobrenome">
                                Sobrenome:
                                <input type="text" class="input-form" name="sobrenome" placeholder="Digite seu sobrenome..." />
                            </label>
                            
                            <label for="cpf">
                                CPF:
                                <input type="text" class="input-form" name="cpf" placeholder="Digite seu cpf..." />
                            </label>
            
                            <label for="telefone">
                                Telefone:
                                <input type="text" class="input-form" name="telefone" placeholder="Ex: (11) 99245-4543" />
                            </label>

                            
                            <label for="data-nasc">
                                Data de Nascimento:
                                <input type="text" class="input-form" name="data-nasc" placeholder= "Ex: 07/04/2003" />
                            </label>
            
                            <label for="restricoes">
                                Restrições Alimentares:
                                <input type="text" class="input-form" name="restricoes" placeholder="Ex: lactose, glúten, etc." />
                            </label>
                        </div>
                    </div>

                </div>

                @* INPUTS ENDEREÇO *@
                <div class="card-endereco">
                    <h4 id="txt-end">
                        Informações de <span style="color: var(--rosa);">Endereço</span>
                    </h4>
                    <div class="conteudo-card">
                        <label for="cep">CEP:</label>
                        <input type="text" class="input-form" name="cep" placeholder="Digite seu CEP..." />
                        
                        <div id="endereco-grid">
                            <div class="end-grid-1">
                                <label for="numero">
                                    Número:
                                    <input type="text" class="input-form" name="numero" placeholder="Nº da casa..." />
                                </label>
                            </div>

                            <div class="end-grid-2">
                                <label for="complemento">
                                    Complemento:
                                    <input type="text" class="input-form" name="complemento" placeholder="Ex: Apto, Bloco, etc..." />
                                </label>
                            </div>
                        </div>
                        
                        <label for="rua">Rua:</label>
                        <input type="text" class="input-form" name="rua" placeholder="Nome da rua..." />
        
                        <label for="estado">Estado:</label>
                        <input type="text" class="input-form" name="estado" placeholder="UF..." />
        
                        <label for="cidade">Cidade:</label>
                        <input type="text" class="input-form" name="cidade" placeholder="Sua Cidade..." />
                    
                        <label for="bairro">Bairro:</label>
                        <input type="text" class="input-form" name="bairro" placeholder="Seu Bairro..." />
                    </div>
                </div>
            </div>

            <div class="textos">
                <span style="display: flex; align-items: center; justify-content: center; color: var(--azul); gap: .3rem;">
                    <input type="checkbox" name="termos" value="sim">
                    Concordo com os termos
                </span>

                <span>
                    <a 
                        asp-controller="Cadastrar" 
                        asp-action="Index" 
                        asp-route-form="login"
                        class="link-form"
                    >
                        Já tenho conta.
                    </a>
                </span>
            </div>
        
            <div class="btns-form">

                <button type="submit" id="criar" class="botao">
                    Criar
                </button>

                <button type="reset" id="limpar" class="botao">
                    Limpar
                </button>

            </div>

    </form>

    <a asp-controller="home" asp-action="index">
        <img src="~/Assets/Icons/Logo.svg" alt="Logo" id="logo" />
    </a>
</section>