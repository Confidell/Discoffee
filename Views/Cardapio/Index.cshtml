@model IEnumerable<Discoffee.Models.Produto>
@{
    ViewData["Title"] = "Cardápio";

    IEnumerable<Discoffee.Models.Produto> De(string categoria) =>
        Model.Where(p => p.Disponibilidade && p.Categoria.NomeCategoria == categoria);
}

@section Styles {
    <link rel="stylesheet" href="~/css/cardapio.css" asp-append-version="true" />
}

<main>
    <header>
        <div class="drinks-especiais">
            <img src="~/Assets/Icons/Logo.svg" />
            <h2>DRINKS ESPECIAIS</h2>
            <p>Aproveite nossos melhore drinks e sinta a melodia da sua alegria vibrar!</p>
        </div>
    </header>

    <section class="sessao-imagens">
        <div class="imagens">
            <img src="~/Assets/Imagens/sessao_img1.png" />
            <img src="~/Assets/Imagens/sessao_img2.png" />
            <img src="~/Assets/Imagens/sessao_img3.png" />
            <img src="~/Assets/Imagens/sessao_img4.png" />
            <img src="~/Assets/Imagens/sessao_img5.png" />
        </div>
        <div class="pedidos-card">
            <div class="formas-pedido">
                <div class="card-pedido">
                    <h2>PEÇA ONLINE</h2>
                    <p>Escolha o desejado e receba no conforto de sua casa.</p>
                </div>

                <div class="card-pedido">
                    <h2>RETIRE NO LOCAL</h2>
                    <p>Faça seu pedido pelo site e retire pessoalmente em nosso estabelecimento.</p>
                </div>

            </div>

            <div class="escolha-produtos">
                <h2>FAÇA SUA ESCOLHA</h2>
                <p>Oferecemos uma variedades de cafés, acompanhamentos, bebidas e muitos outros para satisfazer a sua vontade</p>
            </div>
        </div>
    </section>

    <section class="produtos">

        <div class="card-externo">

            <div class="titulo-lista">
                <h2>CAFÉS</h2>
            </div>

            <div class="subtitulo">
                <h3>Tradicionais</h3>
                <hr />
            </div>

            <div class="lista-produtos">
                @foreach (var p in De("Tradicionais"))
                {
                    <partial name="_CardProduto" model="p" />
                }
            </div>

            <div class="subtitulo">
                <h3>Drinks</h3>
                <hr />
            </div>

            <div class="lista-produtos">
                @foreach (var p in De("Drinks"))
                {
                    <partial name="_CardProduto" model="p" />
                }
            </div>

        </div>
        <div class="banner-cafe">
            <img src="~/Assets/Imagens/Banner_Cafe.jpg" />
        </div>

        <div class="card-externo">

            <div class="titulo-lista">
                <h2>ACOMPANHAMENTOS</h2>
            </div>

            <div class="subtitulo">
                <h3>Doces</h3>
                <hr />
            </div>

            
            <div class="lista-produtos">
                @foreach (var p in De("Doces"))
                {
                    <partial name="_CardProduto" model="p" />
                }
            </div>

            <div class="subtitulo">
                <h3>Salgados</h3>
                <hr />
            </div>

            
            <div class="lista-produtos">
                @foreach (var p in De("Salgados"))
                {
                    <partial name="_CardProduto" model="p" />
                }
            </div>

        </div>
        <div class="banner-cafe">
            <img src="~/Assets/Imagens/Banner_Cafe.jpg" />
        </div>

        <div class="card-externo">

            <div class="titulo-lista">
                <h2>BEBIDAS</h2>
            </div>

            <div class="subtitulo">
                <h3>Refrescos</h3>
                <hr />
            </div>

            <div class="lista-produtos">
                @foreach (var p in De("Refrescos"))
                {
                    <partial name="_CardProduto" model="p" />
                }
            </div>

            <div class="subtitulo">
                <h3>Shakes</h3>
                <hr />
            </div>

            
            <div class="lista-produtos">
                @foreach (var p in De("Shakes"))
                {
                    <partial name="_CardProduto" model="p" />
                }
            </div>

        </div>
        <div class="banner-cafe">
            <img src="~/Assets/Imagens/Banner_Cafe.jpg" />
        </div>
    </section>

</main>

