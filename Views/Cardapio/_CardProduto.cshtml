@*RESPONSÁVEL POR EXIBIR O CARD DE UM PRODUTO*@
@model Discoffee.Models.Produto
@{
    var ptBR = new System.Globalization.CultureInfo("pt-BR");
}

<div class="card-prod">
    <img src="~/Assets/Imagens/@Model.Imagem" alt="@Model.Nome" class="prod-img" />
    <div class="nome-preco">
        <h4>@Model.Nome</h4>
        <span>@Model.Preco.ToString("C2", ptBR)</span>
    </div>
    <article><p>@Model.Descricao</p></article>

    <div class="produto-info">

        <button type="button" title="Ver Detalhes" class="btn-card-prod" data-modal="modal-@Model.IdProduto">
            
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-info-circle-fill icone-info" viewBox="0 0 16 16">
                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
            </svg>
        </button>
    </div>
</div>