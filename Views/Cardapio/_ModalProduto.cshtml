@*EXIBE O MODAL DE DETALHES DO PRODUTO*@
@model Discoffee.Models.Produto;

<div class="paiModal" id="modal-@Model.IdProduto" data-id-produto="@Model.IdProduto">
    <div class="modal-produto">

        <div class="btn-imagem">

            <div class="fechar">
                <img src="~/Assets/Icons/Icon_Fechar.png" class="btn-fechar" id="btn-fechar" />
                <h3>Fechar</h3>
            </div>

            <img src="~/Assets/Imagens/@Model.Imagem" alt="@Model.Nome" class="prod-img" />

            <div class="avaliacoes">
                <h2>Avaliações</h2>
                <img src="/Assets/Icons/Icon_SetaBaixoPreta.png" />
            </div>
        </div>

        <div class="card-externo-prod">
            <div class="card-produto">

                <div class="header-prod">
                    <h2>@Model.Nome</h2>
                    <article><p>@Model.Descricao</p></article>
                </div>
                
                <div class="escolha-item">

                    @*CARREGA AS OPÇÕES DISPONÍVEIS POR CATEGORIA*@
                    <div class="container-opcoes"
                        data-id-categoria="@Model.Categoria.IdCategoria"
                        data-url="@Url.Action(
                            "BuscarOpcoesProduto",
                            "Cardapio",
                            new { idCategoria = Model.Categoria.IdCategoria })">

                        <p>As opções serão carregadas ao abrir o produto.</p>

                    </div>

                </div>

                <div class="qtd-adicionar"> 
                    <div class="seletor-quantidade">
                        <button onclick="mudar(this, -1)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dash menos" viewBox="0 0 16 16">
                                <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8"/>
                            </svg>
                        </button>

                        <span id="quantidade">1</span>

                        <button onclick="mudar(this, 1)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus mais" viewBox="0 0 16 16">
                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                            </svg>
                        </button>
                    </div>
                    <button id="adicionar-carrinho" class="botao add-carrinho">Adicionar ao carrinho</button>
                </div>
            </div>
        </div>

    </div>
</div>